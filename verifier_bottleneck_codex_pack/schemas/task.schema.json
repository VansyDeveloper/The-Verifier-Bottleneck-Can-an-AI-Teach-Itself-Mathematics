{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VBTask",
  "type": "object",
  "required": [
    "task_id",
    "mode",
    "split",
    "p",
    "degree_cap",
    "start",
    "operations"
  ],
  "properties": {
    "task_id": {
      "type": "string"
    },
    "mode": {
      "enum": [
        "apply",
        "plan"
      ]
    },
    "split": {
      "type": "string"
    },
    "p": {
      "type": "integer",
      "minimum": 2
    },
    "degree_cap": {
      "type": "integer",
      "minimum": 1
    },
    "start": {
      "type": "array",
      "items": {
        "type": "integer"
      }
    },
    "target": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "integer"
      }
    },
    "program": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    },
    "operations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "max_steps": {
      "type": [
        "integer",
        "null"
      ]
    },
    "difficulty": {
      "type": "object"
    },
    "metadata": {
      "type": "object"
    }
  }
}