{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GenerationRecord",
  "type": "object",
  "required": [
    "run_id",
    "task_id",
    "candidate_id",
    "text",
    "parse_ok",
    "is_correct"
  ],
  "properties": {
    "run_id": {
      "type": "string"
    },
    "task_id": {
      "type": "string"
    },
    "candidate_id": {
      "type": "integer"
    },
    "text": {
      "type": "string"
    },
    "parsed_program": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    },
    "parsed_result": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "integer"
      }
    },
    "parse_ok": {
      "type": "boolean"
    },
    "is_correct": {
      "type": "boolean"
    },
    "accepted": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "alpha": {
      "type": [
        "number",
        "null"
      ]
    },
    "beta": {
      "type": [
        "number",
        "null"
      ]
    },
    "prompt_tokens": {
      "type": [
        "integer",
        "null"
      ]
    },
    "completion_tokens": {
      "type": [
        "integer",
        "null"
      ]
    },
    "elapsed_seconds": {
      "type": [
        "number",
        "null"
      ]
    },
    "sampling": {
      "type": "object"
    }
  }
}