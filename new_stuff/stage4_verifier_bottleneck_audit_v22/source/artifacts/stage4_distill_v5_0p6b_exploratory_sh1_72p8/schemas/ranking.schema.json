{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stage4.composition.v5.ranking.v1",
  "x-schema-aliases": ["stage4.ranking.v1", "stage4.distill.v5.ranking.v1"],
  "type": "object",
  "required": ["schema", "branch", "split", "task_id", "depth", "p", "ranking"],
  "properties": {
    "schema": {"enum": ["stage4.composition.v5.ranking.v1", "stage4.ranking.v1", "stage4.distill.v5.ranking.v1"]},
    "seed": {"type": "integer", "minimum": 0},
    "branch": {"type": "string", "minLength": 1},
    "split": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "depth": {"enum": [2, 3, 4]},
    "p": {"type": "integer", "minimum": 2},
    "task_fingerprint": {"type": "string", "pattern": "^[0-9A-Fa-f]{64}$"},
    "start": {"type": "array", "minItems": 3, "items": {"type": "integer", "minimum": 0}},
    "target": {"type": "array", "minItems": 3, "items": {"type": "integer", "minimum": 0}},
    "binding": {
      "type": "object",
      "required": ["seed"],
      "properties": {"seed": {"type": "integer", "minimum": 0}},
      "additionalProperties": true
    },
    "hit@1": {"enum": [0, 0.0, 1, 1.0]},
    "hit@8": {"enum": [0, 0.0, 1, 1.0]},
    "hit@16": {"enum": [0, 0.0, 1, 1.0]},
    "hit@32": {"enum": [0, 0.0, 1, 1.0]},
    "hit@64": {"enum": [0, 0.0, 1, 1.0]},
    "correct_mass": {"type": "number", "minimum": 0, "maximum": 1},
    "best_rank": {"type": "integer", "minimum": 1, "maximum": 625},
    "mrr": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
    "log_gap": {"type": "number"},
    "ranking": {
      "type": "array",
      "minItems": 25,
      "maxItems": 625,
      "items": {
        "type": "object",
        "required": ["program", "score", "correct"],
        "properties": {
          "program": {
            "type": "array",
            "minItems": 2,
            "maxItems": 4,
            "items": {"enum": ["SH1", "SC2", "REV", "AC1", "AX1"]}
          },
          "score": {"type": "number"},
          "correct": {"type": "boolean"},
          "rank": {"type": "integer", "minimum": 1, "maximum": 625}
        },
        "additionalProperties": false
      }
    }
  },
  "anyOf": [{"required": ["seed"]}, {"required": ["binding"]}],
  "additionalProperties": true
}
