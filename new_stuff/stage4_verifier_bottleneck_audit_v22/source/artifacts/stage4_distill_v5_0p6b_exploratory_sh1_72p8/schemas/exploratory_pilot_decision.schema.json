{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stage4.composition.v5.exploratory-pilot-decision.v1",
  "type": "object",
  "required": [
    "schema", "status", "scientific_label", "study_class", "registered_atomic_pass",
    "registered_stage4_result_remains", "model", "initial_attempt", "selected_attempt",
    "selected", "dev_cycle", "attempts", "final_created", "composition_confirm_unlocked",
    "confirmatory_claim_allowed", "dev_b_descriptive_sha256"
  ],
  "properties": {
    "schema": {"const": "stage4.composition.v5.exploratory-pilot-decision.v1"},
    "status": {"enum": ["EXPLORATORY_PASS", "EXPLORATORY_FAILED_PILOT_GATE"]},
    "scientific_label": {"enum": ["EXPLORATORY_COMPOSITION_SIGNAL", "EXPLORATORY_NEGATIVE"]},
    "study_class": {"const": "EXPLORATORY_FOLLOWUP"},
    "registered_atomic_pass": {"const": false},
    "registered_stage4_result_remains": {"const": "FAILED_CALIBRATION_GATE"},
    "model": {"const": "Qwen/Qwen3-0.6B"},
    "final_created": {"const": false},
    "composition_confirm_unlocked": {"const": false},
    "confirmatory_claim_allowed": {"const": false},
    "dev_b_descriptive_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"}
  }
}
