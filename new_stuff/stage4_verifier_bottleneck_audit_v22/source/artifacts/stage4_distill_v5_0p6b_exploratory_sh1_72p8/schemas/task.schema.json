{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stage4.composition.v5.task.v1",
  "type": "object",
  "required": [
    "schema", "task_id", "task_fingerprint", "split", "family", "p", "depth",
    "start", "target", "witness", "states", "motif_count", "shortest_depth",
    "shortest_solution_count", "solutions"
  ],
  "properties": {
    "schema": {"const": "stage4.composition.v5.task.v1"},
    "task_id": {"type": "string", "minLength": 1},
    "task_fingerprint": {"type": "string", "pattern": "^[0-9A-Fa-f]{64}$"},
    "split": {"type": "string", "minLength": 1},
    "family": {"type": "string", "minLength": 1},
    "p": {"type": "integer", "minimum": 2},
    "degree": {"type": "integer", "minimum": 2, "maximum": 4},
    "operation": {"$ref": "#/$defs/operation"},
    "depth": {"enum": [1, 2, 3, 4]},
    "start": {"$ref": "#/$defs/state"},
    "target": {"$ref": "#/$defs/state"},
    "witness": {"$ref": "#/$defs/program"},
    "states": {
      "type": "array",
      "minItems": 2,
      "maxItems": 5,
      "items": {"$ref": "#/$defs/state"}
    },
    "motif_count": {"type": "integer", "minimum": 0},
    "shortest_depth": {"type": "integer", "minimum": 1, "maximum": 4},
    "shortest_solution_count": {"type": "integer", "minimum": 1},
    "solutions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": ["program", "states"],
        "properties": {
          "program": {"$ref": "#/$defs/program"},
          "states": {
            "type": "array",
            "minItems": 2,
            "maxItems": 5,
            "items": {"$ref": "#/$defs/state"}
          }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "operation": {"enum": ["SH1", "SC2", "REV", "AC1", "AX1"]},
    "program": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {"$ref": "#/$defs/operation"}
    },
    "state": {
      "type": "array",
      "minItems": 3,
      "items": {"type": "integer", "minimum": 0}
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["family"],
        "properties": {"family": {"const": "ATOMIC"}}
      },
      "then": {
        "required": ["degree", "operation"],
        "properties": {
          "depth": {"const": 1},
          "witness": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/operation"}},
          "states": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/state"}}
        }
      }
    }
  ],
  "additionalProperties": false
}
