{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stage4.composition.v5.atomic-payload-sha256.v1",
  "type": "object",
  "required": ["schema", "root", "files", "file_count", "total_bytes", "tree_sha256"],
  "properties": {
    "schema": {"const": "stage4.composition.v5.atomic-payload-sha256.v1"},
    "root": {"const": "stage4_sh1_v5_0p6b"},
    "files": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
      },
      "additionalProperties": {
        "type": "object",
        "required": ["bytes", "sha256"],
        "properties": {
          "bytes": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^[0-9A-F]{64}$"}
        },
        "additionalProperties": false
      }
    },
    "file_count": {"type": "integer", "minimum": 1},
    "total_bytes": {"type": "integer", "minimum": 0},
    "tree_sha256": {"type": "string", "pattern": "^[0-9A-F]{64}$"}
  },
  "additionalProperties": false
}
