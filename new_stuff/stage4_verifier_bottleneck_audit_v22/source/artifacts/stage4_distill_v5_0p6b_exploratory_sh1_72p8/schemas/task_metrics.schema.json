{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stage4.composition.v5.task-metrics.v1",
  "x-schema-aliases": ["stage4.distill.v5.task-metrics.v1"],
  "type": "object",
  "required": [
    "schema", "branch", "split", "task_id", "depth", "p", "hit@1", "hit@8",
    "hit@16", "hit@32", "hit@64", "correct_mass", "best_rank", "mrr", "log_gap"
  ],
  "properties": {
    "schema": {"enum": ["stage4.composition.v5.task-metrics.v1", "stage4.distill.v5.task-metrics.v1"]},
    "seed": {"type": "integer", "minimum": 0},
    "branch": {"type": "string", "minLength": 1},
    "split": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "depth": {"enum": [2, 3, 4]},
    "p": {"type": "integer", "minimum": 2},
    "task_fingerprint": {"type": "string", "pattern": "^[0-9A-Fa-f]{64}$"},
    "binding": {
      "type": "object",
      "required": ["seed"],
      "properties": {"seed": {"type": "integer", "minimum": 0}},
      "additionalProperties": true
    },
    "hit@1": {"enum": [0, 0.0, 1, 1.0]},
    "hit@8": {"enum": [0, 0.0, 1, 1.0]},
    "hit@16": {"enum": [0, 0.0, 1, 1.0]},
    "hit@32": {"enum": [0, 0.0, 1, 1.0]},
    "hit@64": {"enum": [0, 0.0, 1, 1.0]},
    "correct_mass": {"type": "number", "minimum": 0, "maximum": 1},
    "best_rank": {"type": "integer", "minimum": 1, "maximum": 625},
    "mrr": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
    "log_gap": {"type": "number"}
  },
  "anyOf": [{"required": ["seed"]}, {"required": ["binding"]}],
  "additionalProperties": false
}
