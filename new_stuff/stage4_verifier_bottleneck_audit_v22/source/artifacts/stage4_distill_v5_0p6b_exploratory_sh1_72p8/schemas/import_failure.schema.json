{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stage4.distill.v5.import-failure.v1",
  "type": "object",
  "required": [
    "schema", "status", "attempt", "study_class", "stage", "failure_class",
    "error", "composition_discover_started", "branch_training_started",
    "composition_metrics_observed", "source_checkpoint_mutated",
    "registered_stage4_result_remains", "source_sh1_apply", "git_commit",
    "preregistration_sha256", "log", "partial_model", "failed_at_utc"
  ],
  "properties": {
    "schema": {"const": "stage4.distill.v5.import-failure.v1"},
    "status": {"const": "FAILED"},
    "attempt": {"const": 0},
    "study_class": {"const": "EXPLORATORY_FOLLOWUP"},
    "stage": {"const": "import-atomic"},
    "failure_class": {"const": "NUMERIC_REPRESENTATION_EQUIVALENCE"},
    "composition_discover_started": {"const": false},
    "branch_training_started": {"const": false},
    "composition_metrics_observed": {"const": false},
    "source_checkpoint_mutated": {"const": false},
    "registered_stage4_result_remains": {"const": "FAILED_CALIBRATION_GATE"},
    "source_sh1_apply": {"type": "number", "minimum": 0, "maximum": 1},
    "git_commit": {"type": "string", "pattern": "^[A-Fa-f0-9]{40}$"},
    "preregistration_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "log": {"$ref": "#/$defs/file"},
    "partial_model": {"$ref": "#/$defs/file"},
    "failed_at_utc": {"type": "string"}
  },
  "$defs": {
    "file": {
      "type": "object",
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "bytes": {"type": "integer", "minimum": 1},
        "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"}
      }
    }
  }
}
