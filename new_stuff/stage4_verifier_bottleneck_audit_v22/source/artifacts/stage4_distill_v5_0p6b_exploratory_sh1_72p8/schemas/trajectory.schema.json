{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stage4.composition.v5.trajectory.v1",
  "type": "object",
  "required": [
    "schema", "trajectory_id", "trajectory_fingerprint", "task_id", "split", "p",
    "depth", "start", "target", "program", "states", "motif_count"
  ],
  "properties": {
    "schema": {"const": "stage4.composition.v5.trajectory.v1"},
    "trajectory_id": {"type": "string", "minLength": 1},
    "trajectory_fingerprint": {"type": "string", "pattern": "^[0-9A-Fa-f]{64}$"},
    "task_id": {"type": "string", "minLength": 1},
    "split": {"type": "string", "minLength": 1},
    "p": {"type": "integer", "minimum": 2},
    "depth": {"enum": [2, 3, 4]},
    "start": {"$ref": "#/$defs/state"},
    "target": {"$ref": "#/$defs/state"},
    "program": {"$ref": "#/$defs/program"},
    "states": {
      "type": "array",
      "minItems": 3,
      "maxItems": 5,
      "items": {"$ref": "#/$defs/state"}
    },
    "motif_count": {"type": "integer", "minimum": 0}
  },
  "$defs": {
    "operation": {"enum": ["SH1", "SC2", "REV", "AC1", "AX1"]},
    "program": {
      "type": "array",
      "minItems": 2,
      "maxItems": 4,
      "items": {"$ref": "#/$defs/operation"}
    },
    "state": {
      "type": "array",
      "minItems": 3,
      "items": {"type": "integer", "minimum": 0}
    }
  },
  "additionalProperties": false
}
