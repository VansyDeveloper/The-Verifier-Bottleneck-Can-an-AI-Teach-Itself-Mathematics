{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stage4.composition.v5.atomic-references.v1",
  "type": "object",
  "required": ["schema", "files"],
  "properties": {
    "schema": {"const": "stage4.composition.v5.atomic-references.v1"},
    "files": {
      "oneOf": [
        {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/file"}
        },
        {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "required": ["bytes", "sha256"],
            "properties": {
              "bytes": {"type": "integer", "minimum": 0},
              "sha256": {"type": "string", "pattern": "^[0-9A-Fa-f]{64}$"}
            },
            "additionalProperties": false
          }
        }
      ]
    },
    "selected_adapter": {
      "type": "object",
      "required": ["path", "tree_sha256", "receipt_path", "receipt_sha256", "files_count", "bytes"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "tree_sha256": {"type": "string", "pattern": "^[0-9A-Fa-f]{64}$"},
        "receipt_path": {"type": "string", "minLength": 1},
        "receipt_sha256": {"type": "string", "pattern": "^[0-9A-Fa-f]{64}$"},
        "files_count": {"type": "integer", "minimum": 1},
        "bytes": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "file": {
      "type": "object",
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "bytes": {"type": "integer", "minimum": 0},
        "sha256": {"type": "string", "pattern": "^[0-9A-Fa-f]{64}$"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
